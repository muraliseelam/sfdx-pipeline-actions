<?xml version="1.0" encoding="UTF-8"?>
<!--
  SF_CICD_Deploy — the JWT Connected App the pipeline authenticates through.

  Deploying this as METADATA removes the biggest manual step (clicking through
  Setup > App Manager > New Connected App and uploading the certificate) in
  every org. The bootstrap script injects the certificate body into the
  __CERT_CONTENT__ placeholder before deploy.

  After deploy, the org generates a Consumer Key. The bootstrap script retrieves
  it automatically (sf project retrieve) and writes it to the GitHub Environment
  secret SF_CONSUMER_KEY — you never copy it by hand.

  permittedUsers=adminApproved + isAdminApproved=true set the app to
  "Admin approved users are pre-authorized" so end users can't self-authorize.
-->
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <contactEmail>__CONTACT_EMAIL__</contactEmail>
    <label>SF CICD Deploy</label>
    <oauthConfig>
        <callbackUrl>http://localhost:1717/OauthRedirect</callbackUrl>
        <certificate>__CERT_CONTENT__</certificate>
        <isAdminApproved>true</isAdminApproved>
        <isConsumerSecretOptional>false</isConsumerSecretOptional>
        <isIntrospectAllTokens>false</isIntrospectAllTokens>
        <isSecretRequiredForRefreshToken>false</isSecretRequiredForRefreshToken>
        <scopes>Api</scopes>
        <scopes>RefreshToken</scopes>
        <scopes>Web</scopes>
    </oauthConfig>
</ConnectedApp>
