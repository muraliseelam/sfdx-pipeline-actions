<mxfile host="app.diagrams.net" modified="2026-09-16T00:00:00.000Z" agent="copilot" version="24.0.0" type="device">
  <diagram id="guards" name="Inside a deploy — guards and job graph">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Inside a deploy — the job graph and the three fatal guards" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0D274D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="deploy.yml, as it runs for int / qa / stage. Guards fail the run outright — they are never warnings, because a bypassed guard means an org and a branch disagree." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5B7186;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1200" height="22" as="geometry" />
        </mxCell>

        <mxCell id="j1" value="&lt;b&gt;ctx&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;resolve PR number, head sha,&lt;br/&gt;base branch, actor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="j2" value="&lt;b&gt;plan&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;read the caller's pipeline.config.yml&lt;br/&gt;branch → env, gate, test level,&lt;br/&gt;eff_baseline from delta_baseline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="j3" value="&lt;b&gt;bypass&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;is this a hotfix / ops path?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="345" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="j4" value="&lt;b&gt;changes&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;install SF CLI + sfdx-git-delta&lt;br/&gt;delta vs eff_baseline → package.xml&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="250" height="75" as="geometry" />
        </mxCell>

        <mxCell id="gbox" value="GUARDS — all three must pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d6b656;strokeWidth=2;arcSize=4;verticalAlign=top;align=center;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#7a5c00;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="480" height="430" as="geometry" />
        </mxCell>

        <mxCell id="g1" value="&lt;b&gt;1 · merge-conflict guard&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;Is the PR mergeable?&lt;br/&gt;&lt;i&gt;Retries while GitHub is still computing&lt;br/&gt;mergeability — UNKNOWN is not a pass.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="460" y="150" width="420" height="95" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="&lt;b&gt;2 · ordering guard&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;Did the &lt;i&gt;previous&lt;/i&gt; environment really deploy?&lt;br/&gt;Trusts &lt;b&gt;only&lt;/b&gt; the deploy-&amp;lt;env&amp;gt; commit status,&lt;br/&gt;which only a real deploy ever writes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="460" y="265" width="420" height="95" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="&lt;b&gt;3 · validation guard&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;Is pr-validation green on this head sha?&lt;br/&gt;&lt;i&gt;Entry stage only; skipped on a bypass run.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="460" y="380" width="420" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gnote" value="Any failure → the run stops. Nothing is deployed, nothing is merged." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="460" y="478" width="420" height="24" as="geometry" />
        </mxCell>

        <mxCell id="j5" value="&lt;b&gt;deploy&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#5B7186&quot;&gt;(environment: &amp;lt;env&amp;gt;)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;JWT auth → profiles → sf project deploy&lt;br/&gt;test level from config → coverage gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;arcSize=12;shadow=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1000" y="180" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="j6" value="&lt;b&gt;merge-pr&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;merge only now — the org already took it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="310" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="j7" value="&lt;b&gt;status + labels&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;deploy-&amp;lt;env&amp;gt; commit status&lt;br/&gt;deployed:&amp;lt;env&amp;gt; label on the int PR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="420" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="j8" value="&lt;b&gt;report · audit · notify&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;sticky PR comment · audit trail · chat&lt;br/&gt;&lt;i&gt;chat is a no-op when unconfigured&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="540" width="340" height="80" as="geometry" />
        </mxCell>

        <mxCell id="k1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="j1" target="j2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="j2" target="j3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="j3" target="j4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=3;fontSize=11;fontColor=#7a5c00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="j4" target="g2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k5" value="all green" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=3;fontSize=12;fontColor=#3d6b2e;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="j5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=3;" edge="1" parent="1" source="j5" target="j6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=3;" edge="1" parent="1" source="j6" target="j7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;dashed=1;" edge="1" parent="1" source="j7" target="j8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k9" value="bypass skips guard 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b1b1b1;strokeWidth=2;dashed=1;fontSize=10;fontColor=#8b949e;labelBackgroundColor=#ffffff;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="j3" target="g3"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="34" /></mxGeometry></mxCell>

        <mxCell id="ph" value="&lt;b&gt;Why the ordering guard trusts a commit status and not a deployment record&lt;/b&gt;&lt;br/&gt;A check-only validation run against a GitHub Environment still creates a &lt;i&gt;deployment record&lt;/i&gt;. If the guard believed those, a PR that had merely been validated would look deployed. So pr-validation marks its own record inactive and deletes it, and the guard reads only the &lt;b&gt;deploy-&amp;lt;env&amp;gt;&lt;/b&gt; commit status — written exclusively by a real deploy. A phantom can never satisfy it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;arcSize=8;fontSize=12;align=left;spacingLeft=14;spacingTop=4;verticalAlign=middle;fontColor=#4a3800;" vertex="1" parent="1">
          <mxGeometry x="80" y="660" width="1260" height="95" as="geometry" />
        </mxCell>

        <mxCell id="cc" value="&lt;b&gt;Concurrency&lt;/b&gt; — a caller must never declare the same concurrency group as the reusable workflow it calls (e.g. pr-validation-&amp;lt;pr&amp;gt;). It cancels itself and produces a run with zero jobs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;arcSize=8;fontSize=12;align=left;spacingLeft=14;fontColor=#7a2e2a;" vertex="1" parent="1">
          <mxGeometry x="80" y="775" width="1260" height="58" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
