<mxfile host="app.diagrams.net" modified="2026-09-16T00:00:00.000Z" agent="copilot" version="24.0.0" type="device">
  <diagram id="topology" name="System topology">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Salesforce Pipeline Platform — system topology" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0D274D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One copy of the pipeline logic, consumed by many Salesforce project repos. There is no Salesforce-side application — GitHub Actions is the product." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5B7186;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1000" height="22" as="geometry" />
        </mxCell>

        <mxCell id="consBox" value="CONSUMER&#10;a Salesforce project repo (e.g. sfdx-pipeline-example)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F7FD;strokeColor=#00BCEB;strokeWidth=2;arcSize=6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#0D274D;spacingTop=6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="380" height="520" as="geometry" />
        </mxCell>

        <mxCell id="cw" value="&lt;b&gt;.github/workflows/*.yml&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;8 thin caller workflows&lt;br/&gt;trigger + permissions + uses:&lt;br/&gt;&lt;i&gt;no logic&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00BCEB;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="160" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cfg" value="&lt;b&gt;sf-pipeline/pipeline.config.yml&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#7a5c00&quot;&gt;the only pipeline file a project edits&lt;br/&gt;envs · gates · test levels · thresholds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="300" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="src" value="&lt;b&gt;force-app/&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;Salesforce metadata being shipped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="430" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="consNote" value="Everything else about the pipeline is inherited." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5B7186;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="70" y="540" width="320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="centBox" value="CENTRAL&#10;muraliseelam/sfdx-pipeline-actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#5B7186;strokeWidth=2;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#0D274D;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="100" width="720" height="520" as="geometry" />
        </mxCell>

        <mxCell id="rw" value="&lt;b&gt;.github/workflows/*.yml&lt;/b&gt; &amp;nbsp;— 10 reusable workflows &lt;i&gt;(on: workflow_call)&lt;/i&gt;&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;pr-validation · deploy · sf-promote-label · approve-guard · prod-release&lt;br/&gt;sync-env-branches · org-bootstrap · ops recreate / redeploy / rollback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="160" width="660" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ca" value="&lt;b&gt;sf-pipeline/&amp;lt;action&amp;gt;/action.yml&lt;/b&gt; &amp;nbsp;— 17 composite actions&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;plan · changes · deploy · guard · approval · bypass · merge-pr&lt;br/&gt;report · status · jira · notify · chat · coverage&lt;br/&gt;release-gather · release-preflight · sync-branches&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="310" width="660" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sc" value="&lt;b&gt;sf-pipeline/scripts/*&lt;/b&gt; &amp;nbsp;— 13 shared helpers&lt;br/&gt;&lt;font color=&quot;#5B7186&quot;&gt;plan.py · delta.sh · auth-jwt.sh · profiles.py · audit.py · …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;arcSize=12;shadow=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="470" width="660" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="uses: …/.github/workflows/X.yml@main&#10;secrets: inherit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#00BCEB;strokeWidth=3;fontSize=11;fontColor=#0D274D;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="cw" target="rw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="uses: …/sf-pipeline/&amp;lt;action&amp;gt;@main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#5B7186;labelBackgroundColor=#f6f8fa;" edge="1" parent="1" source="rw" target="ca">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="$GITHUB_ACTION_PATH/../scripts/…" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#5B7186;labelBackgroundColor=#f6f8fa;" edge="1" parent="1" source="ca" target="sc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="read at run time from&#10;the CALLER's checkout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#7a5c00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cfg" target="ca">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="delta source" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#5B7186;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="src" target="sc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="keyNote" value="&lt;b&gt;The contract:&lt;/b&gt; logic only ever flows left-to-right. A caller contributes a trigger and a config file; it never contains pipeline logic.&lt;br/&gt;&lt;b&gt;Today every &lt;i&gt;uses:&lt;/i&gt; pins @main&lt;/b&gt; — moving consumers to an @v1 tag is the top open thread." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;arcSize=8;fontSize=12;align=left;spacingLeft=12;fontColor=#4a3800;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1300" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
