        <mxCell id="w4" value="check-only" style="edgeStyle=none;html=1;dashed=1;strokeColor=#d6b656;strokeWidth=2;fontSize=10;fontColor=#7a5c00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ePV" target="oP"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w5" value="quick-deploy" style="edgeStyle=none;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ePD" target="oP"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="&lt;b&gt;Note the dotted qa / stage arrows.&lt;/b&gt; There is no promotion branch — the feature branch is deployed &lt;i&gt;directly&lt;/i&gt; to each org. The label on the int PR only orchestrates; the delta deployed is always the feature's own.&lt;br/&gt;&lt;b&gt;prod is split across two GitHub Environments&lt;/b&gt; so the long check-only validation can run unattended and the human approval sits immediately before the fast quick-deploy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F7FD;strokeColor=#00BCEB;strokeWidth=1;arcSize=8;fontSize=12;align=left;spacingLeft=12;fontColor=#0D274D;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1880" height="62" as="geometry" />
        </mxCell>

