        <mxCell id="w2" value="JWT deploy" style="edgeStyle=none;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontColor=#5B7186;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="eQ" target="oQ"><mxGeometry relative="1" as="geometry" /></mxCell>
